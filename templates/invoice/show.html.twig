{% extends 'base.html.twig' %}

{% block title %}Invoice{% endblock %}

{% block body %}
<div class="flex flex-col gap-8 py-8 px-50 h-screen overflow-scroll">
        <a class="text-(--gray) flex gap-4 items-center" href="{{ path('app_invoice_index') }}">
            <i class="fa-solid fa-arrow-left"></i>
            <p>Retour au factures</p>
        </a>
    <div class="flex items-center justify-between">
        <div>
            <div class="flex gap-4 items-center">
                <h1 class="font-bold text-2xl">Facture {{invoice.number}}</h1>
                <p
                    class="flex gap-2 rounded items-center px-2 py-1 {{ invoice.status.name == 'draft' ? 'bg-gray-100 text-gray-600' : invoice.status.name === 'pending_payment' ? 'bg-orange-100 text-orange-600' : 'bg-green-100 text-green-600' }}">
                    {% if invoice.status.name == 'paid' %}
                    <i class="fa-regular fa-circle-check"></i>
                    {% else %}
                    <i class="fa-regular fa-clock"></i>
                    {% endif %}
                    {{ invoice.status.value }}
                </p>
            </div>
            <p class="text-(--gray)">Date : {{ invoice.createdAt|date('Y-m-d') }}</p>
        </div>
        <div class="flex gap-4">
            <button class=" white-btn ">
                <i class="fa-regular fa-file"></i>
                <p>PDF</p>
            </button>
            <button class="white-btn ">
                <i class="fa-regular fa-paper-plane"></i>
                <p>Envoyer</p>
            </button>
        </div>
    </div>

    <div class="flex flex-col gap-10 bg-white p-8 border border-(--gray-border) rounded-2xl">
        <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
                <p class="font-bold text-xl">{{ invoice.userId.companyName}}</p>
                <div class="flex flex-col">
                    <p class="text-(--gray) text-[0.9rem]">{{invoice.userId.firstName}} {{invoice.userId.lastName}}</p>
                    <p class="text-(--gray) text-[0.9rem]">{{invoice.userId.email}}</p>
                </div>
            </div>
            <div class="flex flex-col text-end gap-1">
                <p class="font-bold text-xl">Facture</p>
                <div>
                    <p class="text-(--gray) text-[0.9rem]">N° {{ invoice.number }}</p>
                    <p class="text-(--gray) text-[0.9rem]">Date : {{ invoice.createdAt|date('Y-m-d') }}</p>
                </div>
            </div>
        </div>
        <div class="flex justify-end">
            <div class="flex  flex-col gap-2 p-4 rounded-xl w-1/3 bg-gray-50 border border-gray-100 ">
                <p class="text-(--gray) text-[0.9rem]">Facturé À</p>
                <p class="invoice-bold">{{ invoice.clientId.name}}</p>
                <p class="text-(--gray) text-[0.9rem]">{{ invoice.clientId.adress }}</p>
                <p class="text-(--gray) text-[0.9rem]">{{ invoice.clientId.email }}</p>
                {% if invoice.clientId.siret %}
                <p class="text-(--gray) text-[0.9rem]">{{ invoice.clientId.siret }}</p>
                {% endif %}

            </div>
        </div>

        <table class="table table-card shadow-none!">
            <thead class="border-b-2 border-black">
                <tr class="p-4">
                    <th class="py-4 w-full">Description</th>
                    <th class="py-4 w-fit">Qté</th>
                    <th class="py-4 w-fit">Prix Unitaire</th>
                    <th class="py-4 table-cell-center w-fit">Total TTC</th>
                </tr>
            </thead>
            <tbody class="h-">
                {% for item in invoice.invoiceItems %}
                <tr class="table-row">
                    <td class="flex flex-col w-full gap-1">
                        <p>{{ item.productId.name }}</p>
                        <p class="text-(--gray) text-[0.9rem]">{{ item.productId.description }}</p>
                    </td>
                    <td class="w-fit table-cell-center">{{ item.quantity }}</td>
                    <td class="w-fit table-cell-center">{{ item.productId.price }}</td>
                    <td class="table-cell-center font-bold w-fit">{{ item.quantity * item.productId.price }} €</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="flex gap-4 flex-col ">
            <div class="flex justify-end">
                <div class="w-1/5 flex  flex-col gap-2">
                    <div class="flex justify-between p-2 font-bold border-b-2 border-(--gray-border)">
                        <p>Total HT </p>
                        <p>{{ invoice.totalTtc }} €</p>
                    </div>
                    <div class="flex justify-between p-2 font-bold border-b-2 border-black">
                        <p>Total TTC</p>
                        <p>{{ invoice.totalTtc }} €</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-col border-t border-(--gray-border)">
                <p class="text-xs mt-1 text-end text-(--gray)">TVA non applicable, art. 293 B du CGI</p>
                <p>Conditions de paiement</p>
            </div>
            <div class="flex w-full flex-col gap-2 p-4 rounded-xl  bg-gray-50 border border-gray-100 ">
                <p class="text-(--gray)">Coordonnées bancaires pour le paiement :</p>
                <p>{{ invoice.userId.iban }}</p>
            </div>
        </div>




    </div>

</div>

{# {{ include('invoice/_delete_form.html.twig') }} #}
{% endblock %}