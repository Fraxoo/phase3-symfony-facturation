{% extends 'base.html.twig' %}

{% block title %}Invoice
{% endblock %}

{% block body %}
	<div class="flex flex-col gap-8 py-8 px-50 h-screen overflow-scroll">
		<a class="text-(--gray) flex gap-4 items-center" href="{{ path('app_invoice_index') }}">
			<i class="fa-solid fa-arrow-left"></i>
			<p>Retour au factures</p>
		</a>
		<div class="flex items-center justify-between">
			<div>
				<div class="flex gap-4 items-center">
					<h1 class="font-bold text-2xl">Facture
						{{invoice.number}}</h1>
					<p class="flex gap-2 rounded items-center px-2 py-1 {{ invoice.status.name == 'draft' ? 'bg-gray-100 text-gray-600' : invoice.status.name === 'pending_payment' ? 'bg-orange-100 text-orange-600' : 'bg-green-100 text-green-600' }}">
						{% if invoice.status.name == 'paid' %}
							<i class="fa-regular fa-circle-check"></i>
						{% else %}
							<i class="fa-regular fa-clock"></i>
						{% endif %}
						{{ invoice.status.value }}
					</p>
				</div>
				<p class="text-(--gray)">Date :
					{{ invoice.createdAt|date('Y-m-d') }}</p>
			</div>
			<div class="flex gap-4">
				<button class=" white-btn ">
					<i class="fa-regular fa-file"></i>
					<p>PDF</p>
				</button>
				<button class="white-btn ">
					<i class="fa-regular fa-paper-plane"></i>
					<p>Envoyer</p>
				</button>
			</div>
		</div>

		<twig:InvoicePdf invoice="{{ invoice }}"/>

	</div>

	{# {{ include('invoice/_delete_form.html.twig') }} #}
{% endblock %}
